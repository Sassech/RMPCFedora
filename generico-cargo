FROM fedora:latest

ARG REPO_URL=https://github.com/mierak/rmpc.git
ARG BRANCH=master

RUN dnf install -y \
    rust cargo git rpm-build rpmdevtools openssl-devel gcc make \
    && dnf clean all

RUN cargo install cargo-rpm

WORKDIR /build

RUN git clone --branch ${BRANCH} ${REPO_URL} app

WORKDIR /build/app

RUN cargo rpm init && cargo rpm build

RUN mkdir -p /output && cp target/release/rpmbuild/RPMS/x86_64/*.rpm /output/

VOLUME ["/output"]

CMD ["bash", "-c", "cp /output/*.rpm /final/"]
